<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- The process: configuration, logging, database startup, Kestrel, Windows Service and systemd. -->
  <PropertyGroup>
    <RootNamespace>Weir.Host</RootNamespace>
    <AssemblyName>Weir</AssemblyName>
    <OutputType>Exe</OutputType>
    <!-- Not hosted by IIS, and the web app is served from WEIR_WEB_DIST, not wwwroot. -->
    <IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
    <PublishDocumentationFiles>false</PublishDocumentationFiles>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
  </PropertyGroup>
  <!--
    Publishing for a runtime (-r win-x64 | linux-x64 | linux-arm64, or a profile in
    Properties/PublishProfiles) produces one self-contained executable.
  -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Weir.Api\Weir.Api.csproj" />
    <ProjectReference Include="..\Weir.Core\Weir.Core.csproj" />
    <ProjectReference Include="..\Weir.Infrastructure\Weir.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Weir.Api.Tests" />
  </ItemGroup>
</Project>
