{
  "remux_output": [
    {
      "name": "partial-download",
      "input": {
        "probe": "{\"format\": {\"duration\": \"212.546\"}, \"streams\": [{\"codec_type\": \"video\", \"duration\": \"212.546\"}, {\"codec_type\": \"audio\", \"duration\": \"212.546\"}]}",
        "expected_audio": 1,
        "expected_duration_seconds": "5384.046"
      },
      "expected": {
        "error": {
          "type": "MediaCompletenessError",
          "message": "Validation failed: the staged output is incomplete (212.5s of 5384.0s expected), so it was not published."
        }
      }
    },
