{
  "name": "mediamop-web",
  "private": true,
  "version": "2.5.1",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run dev:stop-api && npm run dev:stop-web && node ./scripts/run-dev-stack.mjs",
    "dev:stop-api": "node ../../scripts/stop-dev-api-port.mjs",
    "dev:stop-web": "node ../../scripts/stop-dev-web-port.mjs",
    "dev:quick": "node ./scripts/run-dev-stack.mjs",
    "dev:web": "node ./node_modules/vite/bin/vite.js",
    "lint": "eslint src --max-warnings 0",
    "lint:fix": "eslint src --fix",
    "format": "prettier --check --end-of-line auto \"src/**/*.{ts,tsx,css}\" \"index.html\" \"vite.config.ts\"",
    "format:fix": "prettier --write --end-of-line auto \"src/**/*.{ts,tsx,css}\" \"index.html\" \"vite.config.ts\"",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "api:openapi:export": "node ./scripts/export-openapi.mjs",
    "api:types:generate": "openapi-typescript ./openapi/mediamop-openapi.json -o ./src/lib/api/generated/openapi-types.ts && prettier --write --end-of-line auto ./src/lib/api/generated/openapi-types.ts",
    "api:types:sync": "npm run api:openapi:export && npm run api:types:generate",
    "api:types:check": "npm run api:types:sync && git diff --exit-code -- openapi/mediamop-openapi.json src/lib/api/generated/openapi-types.ts",
    "ci": "npm run lint && npm run format && npm run build && npm run test"
  },
  "dependencies": {
    "@fontsource/outfit": "^5.3.0",
    "@tanstack/react-query": "^5.102.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "autoprefixer": "^10.5.4",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "openapi-typescript": "^7.10.1",
    "postcss": "^8.4.49",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "ts-prune": "^0.10.3",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
