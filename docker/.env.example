# Weir Docker environment example.
# Copy this file to `.env.weir` in the repository root if you want to override defaults:
#   docker compose --env-file .env.weir up -d

# Optional. If omitted, the container generates a high-entropy secret and persists it to:
#   $WEIR_HOME/session.secret
# To create your own:
#   openssl rand -hex 32
# WEIR_SESSION_SECRET=

# Recommended before saving Sonarr or Radarr credentials.
# Generate a different value from WEIR_SESSION_SECRET:
#   openssl rand -hex 32
# WEIR_CREDENTIALS_SECRET=

# Persistent data root inside the container. The default compose volume maps this path.
# WEIR_HOME=/data/weir

# Optional runtime UID/GID remap for the weir user inside the container.
# Aliases PUID / PGID are also accepted.
# WEIR_PUID=1000
# WEIR_PGID=1000

# Optional image override.
# WEIR_DOCKER_IMAGE=ghcr.io/jampat000/weir:latest

# Default image uses HTTP-friendly cookies for localhost/LAN use.
# Set true only when every browser reaches Weir through HTTPS.
# WEIR_SESSION_COOKIE_SECURE=false

# Optional reverse proxy trust. Only set this to the immediate trusted proxy IP/CIDR.
# WEIR_TRUSTED_PROXY_IPS=
